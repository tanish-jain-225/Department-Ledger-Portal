# ==============================================================================
# Department Ledger Portal - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# In production (e.g. Vercel), configure these variables in project settings.
# ==============================================================================

# ==============================================================================
# SECTION A: REQUIRED KEYS
# Core application infrastructure and AI processing. The portal will fail to
# function properly if any of these variables are missing.
# ==============================================================================

# --- A.1 Firebase Client Configuration (NEXT_PUBLIC_*) -----------------------
# Required for Firebase Client SDK: Authentication, Cloud Firestore & Storage.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# --- A.2 Google Gemini AI Engine (Server-Only) --------------------------------
# Required for AI-powered autofill and career readiness intelligence.
# CRITICAL: Never prefix GEMINI_API_KEY with NEXT_PUBLIC_ (server-only secret).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash


# ==============================================================================
# SECTION B: OPTIONAL KEYS
# Advanced security, distributed rate limiting, diagnostics, and demo testing.
# Safe to leave blank or default during standard development and evaluation.
# ==============================================================================

# --- B.1 Security & CORS Restrictions (Server-Only) ---------------------------
# Restricts AI API endpoints (/api/analyze-readiness, /api/autofill-section).
# Set to your exact production URL. Localhost and 127.0.0.1 are always permitted.
ALLOWED_ORIGIN=https://department-ledger-portal.vercel.app

# Rate Limiter backend: 'shared' (Firestore-backed) or 'memory' (in-memory only).
# Defaults to memory in tests or when service account credentials are not provided.
RATE_LIMIT_STORE=memory

# Health check debug token for authorized inspection on /api/health.
# Send matching 'x-health-debug-token' request header to receive service details.
HEALTHCHECK_DEBUG_TOKEN=

# --- B.2 Firebase Admin SDK Service Account (Server-Only) ---------------------
# Required only if RATE_LIMIT_STORE=shared or explicit Admin SDK writes.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- B.3 Demo & Evaluation Accounts (Client-Side) ------------------------------
# Pre-fills 1-click test credentials on /login and /register pages.
# Leave blank in production environments.
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=
NEXT_PUBLIC_DEMO_FACULTY_EMAIL=
NEXT_PUBLIC_DEMO_FACULTY_PASSWORD=
NEXT_PUBLIC_DEMO_STUDENT_EMAIL=
NEXT_PUBLIC_DEMO_STUDENT_PASSWORD=
