NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only - never expose these to the client bundle
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional: restrict AI endpoint CORS to your production deployment origin.
# If set, only this exact origin (plus localhost) is allowed.
# If omitted, the endpoints accept any origin (matches legacy behaviour).
# Example: ALLOWED_ORIGIN=https://department-ledger-portal.vercel.app
ALLOWED_ORIGIN=

# Optional: use 'shared' to enable Firestore-backed distributed rate limiting.
# Use 'memory' to force in-memory only. Defaults to memory when credentials are absent.
RATE_LIMIT_STORE=

# Optional: explicit Firebase service-account credentials for local server-side auth.
# If omitted, firebase-admin uses Application Default Credentials (ADC) fallback.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional: enables detailed /api/health debug output when the request
# includes matching 'x-health-debug-token' header.
HEALTHCHECK_DEBUG_TOKEN=

# Demo credentials for testing - these should be changed in production and not shared publicly
NEXT_PUBLIC_DEMO_ADMIN_EMAIL=
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=
NEXT_PUBLIC_DEMO_FACULTY_EMAIL=
NEXT_PUBLIC_DEMO_FACULTY_PASSWORD=
NEXT_PUBLIC_DEMO_STUDENT_EMAIL=
NEXT_PUBLIC_DEMO_STUDENT_PASSWORD=
